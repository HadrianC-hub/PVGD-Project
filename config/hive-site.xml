<?xml version="1.0"?>
<configuration>
  
  <!-- Configuración de Metastore -->
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore:9083</value>
  </property>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/user/hive/warehouse</value>
  </property>
  
  <!-- Configuraciones para evitar problemas -->
  <property>
    <name>hive.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>
  
  <!-- Configuraciones básicas -->
  <property>
    <name>hive.support.concurrency</name>
    <value>false</value>
  </property>
  <!-- Forzar el bind del Thrift Metastore a 0.0.0.0 y asegurar puerto -->
  <property>
    <name>hive.metastore.thrift.port</name>
    <value>9083</value>
  </property>
  <property>
    <name>hive.metastore.thrift.bind.host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>hive.metastore.bind.host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>hive.txn.manager</name>
    <value>org.apache.hadoop.hive.ql.lockmgr.DummyTxnManager</value>
  </property>
</configuration>
